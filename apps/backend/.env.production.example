# PORTAL SDM v3 - Production Environment Configuration
# Copy this file to .env and fill in the actual values

# [SERVER]
NODE_ENV=production
PORT=3333

# [DATABASE]
# Path to the SQLite database file inside the container
DB_SOURCE=/data/database.sqlite

# [SECURITY] - CRITICAL
# Generate a strong secret (e.g., openssl rand -base64 32)
# MANDATORY: The app will crash if this is not set in production
JWT_SECRET=your_very_strong_random_secret_here

# [CORS]
# List of allowed origins separated by commas
CORS_ORIGIN=https://sdm.yourdomain.com,https://api.yourdomain.com

# [STORAGE]
# Path for file uploads
BACKUP_PATH=/backups
UPLOADS_PATH=/app/public/uploads
