{
  "name": "sistem-manajemen-sdm",
  "version": "1.0.0",
  "description": "Sistem Manajemen Sumber Daya Manusia yang komprehensif untuk mengelola karyawan, cuti, penggajian, dan kinerja.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test:performance-cycle": "ts-node tests/performance-cycle.integration.ts",
    "migrate": "ts-node db/migrate.ts",
    "seed": "ts-node db/seed.ts",
    "reset": "ts-node db/reset.ts",
    "seed:company-settings": "ts-node db/seed-company-settings.ts",
    "migrate:notifications": "node run_notifications_migration.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "hasown": "^2.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.0",
    "pdfkit": "^0.17.2",
    "react-hook-form": "^7.65.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-validator": "^2.20.33",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.3",
    "@types/sqlite3": "^3.1.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
